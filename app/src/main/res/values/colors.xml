<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand -->
    <color name="primary">#E2725B</color>
    <color name="on_primary">#FFFFFF</color>

    <!--
      Calendar palette, matched to the reference tracker the user supplied:
      a solid warm fill for a recorded period, pale pink for the predicted
      period, sky blue for the fertile window, lavender for ovulation day, and
      a gold ring (not a fill) for today.
    -->
    <color name="cal_period">#E2725B</color>
    <color name="cal_period_on">#FFFFFF</color>
    <color name="cal_predicted">#FBDAD5</color>
    <color name="cal_predicted_on">#B3555A</color>
    <color name="cal_fertile">#6FC3E8</color>
    <color name="cal_fertile_on">#FFFFFF</color>
    <color name="cal_ovulation">#D9C2F0</color>
    <color name="cal_ovulation_on">#6B4E9E</color>
    <color name="cal_today_ring">#D9B36C</color>

    <!-- Text -->
    <color name="text_primary">#212121</color>
    <color name="text_secondary">#757575</color>

    <!-- Widget surfaces -->
    <color name="widget_bg">#FFFFFF</color>
    <color name="widget_stroke">#EDE7E4</color>

    <!-- Legacy names still referenced by the widget icon mapping -->
    <color name="period_red">#E2725B</color>
    <color name="ovulation_orange">#6B4E9E</color>
    <color name="fertile_pink">#2E8BB0</color>
    <color name="next_blue">#B3555A</color>
    <color name="today_green">#B08D3F</color>
</resources>
