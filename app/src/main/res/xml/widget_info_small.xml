<?xml version="1.0" encoding="utf-8"?>
<!--
  2x1 widget. minWidth/minHeight follow the platform cell formula
  (70dp * cells - 30dp), so minWidth 110dp = 2 cells and minHeight 40dp = 1 cell.
  targetCell* pins the exact size on API 31+; updatePeriodMillis is 0 because the
  refresh cadence belongs to WorkManager, which survives reboots and respects Doze.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_layout_small"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="0"
    android:previewImage="@drawable/widget_preview"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
